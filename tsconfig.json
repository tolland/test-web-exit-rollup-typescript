{
  "include": ["src/**/*"],
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@WebExtension/*": [
        "./src/WebExtension/*"
      ],
      "@web-lib/*": [
        "./src/lib/*"
      ]
    }
  },
}
