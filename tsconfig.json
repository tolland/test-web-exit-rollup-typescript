{
  "include": ["src/**/*"],
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "src",
    "outDir": "dist",
    "sourceMap": true,
    "paths": {
      "@WebExtension/*": [
        "WebExtension/*"
      ],
      "@lib": [
        "lib/*"
      ]
    }
  },
}
